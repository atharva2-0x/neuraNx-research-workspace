# SQLite is the zero-configuration default. Docker uses PostgreSQL.
DATABASE_URL=sqlite:///data/fund.db
DATA_DIR=data
MAX_UPLOAD_MB=25
# Optional: embeddings and answer composition. No API key is required for the demo.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ENABLE_LLM=false
ENABLE_EMBEDDINGS=false

